---
interface Props {
  related: Array<{ slug: string; title: string; description: string; readTime: string }>;
}
const { related } = Astro.props;
---

{related.length > 0 && (
  <section class="related-guides">
    <h2>Related Guides</h2>
    <div class="related-grid">
      {related.map((g) => (
        <a href={`/guides/${g.slug}/`} class="related-card">
          <h3>{g.title}</h3>
          <p>{g.description}</p>
          <span class="read-time">{g.readTime}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-guides {
    margin: 3rem 0 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .related-guides h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: 1.5rem;
    color: #5eb8c7;
    margin-bottom: 1.25rem;
  }
  .related-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .related-card {
    display: block;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .related-card:hover {
    border-color: rgba(94, 184, 199, 0.4);
  }
  .related-card h3 {
    color: #e8e8e8;
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }
  .related-card p {
    color: #888;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  .related-card .read-time {
    color: #555;
    font-size: 0.8rem;
  }
</style>
