  <link rel="canonical" href="https://aureliusagent.com/">
  <meta property="og:title" content="Aurelius Agent — Your AI Accountability Partner">
  <meta property="og:description" content="Journal daily. Get scored nightly. Face the truth weekly. A discipline system built on Stoic philosophy.">
  <meta property="og:type" content="website">
