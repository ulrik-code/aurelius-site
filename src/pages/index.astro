  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Aurelius Agent — Your AI Accountability Partner">
  <meta name="twitter:description" content="Journal daily. Get scored nightly. Face the truth weekly.">
  <meta name="twitter:image" content="https://aureliusagent.com/aurelius-bust.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Geist:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #0e1016;
      --text: #f0f0f0;
      --text-muted: #888;
      --accent-teal: #5eb8c7;
      --accent-gold: #d4a500;
      --accent-gold-hover: #c49800;
      --error: #f59e0b;
      --card-bg: rgba(255, 255, 255, 0.03);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-hover: rgba(94, 184, 199, 0.4);
      --font: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font);
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ── Nav ── */
    nav {
      padding: 1.5rem 3rem;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(14, 16, 22, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: background 0.3s ease;
    }

    .logo {
      display: block;
      text-decoration: none;
    }

    .logo-img {
      height: 80px;
      width: auto;
      display: block;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .nav-link {
      color: var(--text);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .nav-link:hover {
      color: var(--accent-teal);
    }

    .nav-btn {
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      padding: 0.5rem 1.25rem;
      border-radius: 4px;
      transition: background-color 0.2s ease, color 0.2s ease;
      background: var(--accent-teal);
      color: var(--bg);
      border: none;
    }

    .nav-btn:hover {
      background: #4da3b2;
    }

    /* ── Sections ── */
    .section {
      padding: 6rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      text-align: center;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .section-subtitle {
      text-align: center;
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-bottom: 3rem;
    }

    /* ── Hero ── */
    .hero {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      padding: 10rem 3rem 3rem;
      max-width: 1200px;
      margin: 0 auto;
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -5%;
      transform: translateY(-50%);
      width: 45%;
      height: 65%;
      background: radial-gradient(ellipse at center, rgba(0, 188, 212, 0.06) 0%, rgba(0, 188, 212, 0.02) 35%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-left {
      flex: 1.15;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      max-width: 420px;
      z-index: 1;
    }

    .hero-identity {
      margin-bottom: 2.5rem;
    }

    .hero-action {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .hero-action .btn-gold {
      margin-top: 0.75rem;
    }

    .hero-right {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      background: transparent;
      z-index: 1;
    }

    .wordmark {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 3.5rem;
      font-weight: 300;
      letter-spacing: 0.35em;
      color: var(--accent-teal);
      margin-bottom: 1rem;
      text-transform: uppercase;
      text-align: left;
    }

    .wordmark-suffix {
      font-size: 0.4em;
      letter-spacing: 0.6em;
      vertical-align: 0.4em;
      opacity: 0.8;
      margin-left: 0.1em;
    }

    .hero-headline {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 400;
      line-height: 1.4;
      margin-bottom: 0.5rem;
      color: rgba(255, 255, 255, 0.9);
      text-align: left;
    }

    .hero-subheadline {
      font-size: 1.15rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.6);
      text-align: left;
      white-space: nowrap;
    }

    .hero-image-wrapper {
      position: relative;
      display: inline-block;
    }

    .hero-image-wrapper::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 70%;
      height: 70%;
      background: radial-gradient(ellipse at center, rgba(0, 188, 212, 0.18) 0%, rgba(0, 188, 212, 0.08) 30%, rgba(0, 188, 212, 0.02) 55%, transparent 70%);
      border-radius: 50%;
      z-index: -1;
      filter: blur(40px);
    }

    .hero-image {
      width: 100%;
      max-width: 520px;
      height: auto;
      display: block;
      filter: drop-shadow(0 0 20px rgba(0, 188, 212, 0.12)) drop-shadow(0 0 50px rgba(0, 188, 212, 0.05));
    }

    .hero-hook-setup {
      font-size: 1.3rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.5);
      line-height: 1.4;
    }

    .hero-hook-punch {
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--accent-teal);
      line-height: 1.4;
    }

    /* ── Buttons ── */
    .btn-gold {
      display: inline-block;
      padding: 0.875rem 2.5rem;
      font-size: 1.05rem;
      font-family: var(--font);
      font-weight: 600;
      background: var(--accent-teal);
      color: var(--bg);
      border: none;
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .btn-gold:hover {
      background: #4da3b2;
    }

    .btn-outline {
      display: inline-block;
      padding: 0.875rem 2.5rem;
      font-size: 1.05rem;
      font-family: var(--font);
      font-weight: 500;
      background: transparent;
      color: var(--accent-teal);
      border: 1px solid var(--accent-teal);
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .btn-outline:hover {
      background: var(--accent-teal);
      color: var(--bg);
    }

    /* ── Problem ── */
    .problem {
      text-align: center;
      padding: 3rem 2rem;
      max-width: 700px;
      margin: 0 auto;
    }

    .problem h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 2.5rem;
      color: var(--text);
    }

    .pain-points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .pain-points li {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .problem-closer {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.75rem;
      color: var(--accent-teal);
      font-weight: 400;
    }

    /* ── Solution ── */
    .solution {
      text-align: center;
      padding: 3rem 2rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .solution h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
    }

    .solution p {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.15rem;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.8);
    }

    /* ── Timeline ── */
    .timeline-section {
      padding: 3.5rem 2rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .timeline {
      position: relative;
      padding-left: 3rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 7px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--accent-teal);
      opacity: 0.4;
    }

    .timeline-step {
      position: relative;
      margin-bottom: 2.5rem;
      padding-left: 1.5rem;
    }

    .timeline-step:last-child {
      margin-bottom: 0;
    }

    .timeline-step::before {
      content: '';
      position: absolute;
      left: -2.85rem;
      top: 0.5rem;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent-teal);
      border: 2px solid var(--bg);
      z-index: 1;
    }

    .timeline-time {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent-gold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.25rem;
    }

    .timeline-label {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--text);
      margin-bottom: 0.35rem;
    }

    .timeline-desc {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ── Features ── */
    .features-section {
      padding: 3.5rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .feature-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 2.5rem 2rem;
      transition: border-color 0.2s ease, background 0.2s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 180px;
    }

    .feature-card:hover {
      border-color: var(--card-border-hover);
      background: rgba(255, 255, 255, 0.05);
    }

    .feature-title {
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--accent-teal);
      margin-bottom: 0.75rem;
    }

    .feature-description {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.75);
    }

    /* ── Pricing (removed — waitlist only) ── */

    /* ── Featured Guides ── */
    .featured-guides {
      padding: 3.5rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-top: 2rem;
      text-align: left;
    }

    .featured-card {
      display: block;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 1.5rem 1.5rem 1.25rem;
      text-decoration: none;
      transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .featured-card:hover {
      border-color: var(--card-border-hover);
      background: rgba(255, 255, 255, 0.05);
      transform: translateY(-2px);
    }

    .featured-card h3 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.4rem;
      font-weight: 400;
      color: var(--accent-teal);
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    .featured-card p {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 0.75rem;
    }

    .featured-card .read-time {
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .featured-all {
      display: inline-block;
      margin-top: 2rem;
      color: var(--accent-teal);
      text-decoration: none;
      font-size: 0.95rem;
      border-bottom: 1px solid rgba(94, 184, 199, 0.3);
      padding-bottom: 2px;
      transition: border-color 0.2s ease;
    }

    .featured-all:hover {
      border-color: var(--accent-teal);
    }

    /* ── Final CTA ── */
    .final-cta {
      text-align: center;
      padding: 3.5rem 2rem;
      max-width: 700px;
      margin: 0 auto;
    }

    .final-cta h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 1rem;
    }

    .final-cta .final-subtext {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .form-row {
      display: flex;
      gap: 0.75rem;
      max-width: 400px;
      margin: 0 auto;
    }

    .hp-field {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .email-input {
      flex: 1;
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      font-family: var(--font);
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 4px;
      color: var(--text);
      outline: none;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .email-input::placeholder {
      color: var(--text-muted);
    }

    .email-input:focus {
      border-color: var(--accent-teal);
      box-shadow: 0 0 0 3px rgba(94, 184, 199, 0.15);
    }

    .submit-btn {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      font-family: var(--font);
      font-weight: 500;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 4px;
      color: var(--text-muted);
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      white-space: nowrap;
    }

    .submit-btn:hover:not(:disabled) {
      border-color: var(--accent-teal);
      color: var(--accent-teal);
    }

    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .form-message {
      font-size: 0.875rem;
      margin-top: 0.5rem;
    }

    .form-message.error {
      color: var(--error);
    }

    .success-message {
      color: var(--accent-gold);
      font-size: 1rem;
      font-weight: 500;
    }

    .hidden {
      display: none;
    }

    /* ── Footer ── */
    footer {
      padding: 2.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      border-top: 1px solid var(--card-border);
      max-width: 1100px;
      margin: 0 auto;
    }

    .footer-left a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-left a:hover {
      color: var(--accent-teal);
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--accent-teal);
    }


    /* ── Responsive ── */
    @media (max-width: 900px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }

    }

    @media (max-width: 768px) {
      nav {
        padding: 1rem 1.5rem;
      }

      .nav-link {
        display: none;
      }

      .logo-img {
        height: 50px;
      }

      .hero {
        flex-direction: column;
        padding: 7rem 1.5rem 3rem;
        text-align: center;
      }

      .hero-left {
        align-items: center;
      }

      .hero-identity {
        text-align: center;
      }

      .hero-action {
        align-items: center;
        text-align: center;
      }

      .wordmark {
        font-size: 2.5rem;
        letter-spacing: 0.25em;
        text-align: center;
      }

      .hero-headline {
        font-size: 1.35rem;
      }

      .hero-subheadline {
        white-space: normal;
      }

      .hero-image {
        max-width: 300px;
      }

      .btn-gold, .btn-outline {
        width: 100%;
        text-align: center;
      }

      .section-heading,
      .problem h2,
      .solution h2,
      .final-cta h2 {
        font-size: 1.75rem;
      }

      .problem, .solution, .timeline-section, .features-section, .featured-guides, .final-cta {
        padding: 2.5rem 1.5rem;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }

      .featured-grid {
        grid-template-columns: 1fr;
      }

      .feature-card {
        min-height: auto;
      }

      .timeline::before {
        display: none;
      }

      .timeline {
        padding-left: 0;
      }

      .timeline-step {
        padding-left: 0;
        padding: 1.5rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 8px;
      }

      .timeline-step::before {
        display: none;
      }

      .form-row {
        flex-direction: column;
      }

      footer {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
        padding: 2rem 1.5rem;
      }
    }
  </style>

