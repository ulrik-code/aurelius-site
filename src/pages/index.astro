---
import { getCollection } from 'astro:content';

const featuredSlugs = [
  'ai-journaling-for-men',
  'journal-like-marcus-aurelius',
  'philosophical-accountability',
  'ai-reflection-scoring',
];

const allGuides = await getCollection('guides');
const guidesBySlug = new Map(allGuides.map((g) => [g.id, g.data]));
const featuredGuides = featuredSlugs
  .map((slug) => {
    const data = guidesBySlug.get(slug);
    return data ? { slug, title: data.title, description: data.description, readTime: data.readTime } : null;
  })
  .filter((g): g is NonNullable<typeof g> => Boolean(g));
---
<!DOCTYPE html>
