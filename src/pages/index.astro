---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aurelius Agent | AI Accountability Partner Built on Stoic Philosophy</title>
  <meta name="description" content="Aurelius Agent is your AI accountability partner — Stoic judgment, daily scoring, and weekly narratives that tell you what you won't tell yourself.">
  <link rel="canonical" href="https://aureliusagent.com/">
  <meta property="og:title" content="Aurelius Agent — Your AI Accountability Partner">
  <meta property="og:description" content="A discipline system built on Stoic philosophy. Aurelius makes sure you don't quit.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://aureliusagent.com/">
  <meta property="og:site_name" content="Aurelius Agent">
  <meta property="og:image" content="https://aureliusagent.com/aurelius-bust.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Aurelius Agent — Your AI Accountability Partner">
  <meta name="twitter:description" content="A discipline system built on Stoic philosophy. Aurelius makes sure you don't quit.">
  <meta name="twitter:image" content="https://aureliusagent.com/aurelius-bust.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Geist:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #111319;
      --bg-deep: #111319;
      --text: #f0f0f0;
      --text-muted: #888;
      --accent-teal: #5eb8c7;
      --accent-gold: #d4a500;
      --accent-gold-hover: #c49800;
      --error: #f59e0b;
      --card-bg: rgba(255, 255, 255, 0.03);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-border-hover: rgba(94, 184, 199, 0.4);
      --font: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
      overflow-x: hidden;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a:focus-visible,
    button:focus-visible,
    input:focus-visible {
      outline: 2px solid var(--accent-gold);
      outline-offset: 3px;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ── Nav ── */
    nav {
      padding: 1.5rem 3rem;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(17, 19, 25, 0.86);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      transition: background 0.3s ease;
    }

    .logo {
      display: block;
      text-decoration: none;
    }

    .logo-img {
      height: 80px;
      width: auto;
      display: block;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .nav-link {
      color: var(--text);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }

    .nav-link:hover {
      color: var(--accent-teal);
    }

    .nav-btn {
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      padding: 0.5rem 1.25rem;
      border-radius: 999px;
      transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
      background: linear-gradient(135deg, var(--accent-gold), #f0cf79);
      color: var(--bg);
      border: none;
      box-shadow: 0 12px 30px rgba(212, 165, 0, 0.18);
    }

    .nav-btn:hover {
      background: linear-gradient(135deg, #e5bc44, var(--accent-gold-hover));
      transform: translateY(-1px);
    }

    /* ── Sections ── */
    .section {
      padding: 6rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      text-align: center;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .section-subtitle {
      text-align: center;
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-bottom: 3rem;
    }

    /* ── Hero ── */
    .hero {
      display: flex;
      align-items: flex-start;
      gap: clamp(1.75rem, 5vw, 4rem);
      padding: 10rem 3rem 4rem;
      max-width: 1200px;
      margin: 0 auto;
      overflow: hidden;
      position: relative;
    }

    .hero::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -5%;
      transform: translateY(-50%);
      width: 45%;
      height: 65%;
      background: radial-gradient(ellipse at center, rgba(123, 212, 227, 0.055) 0%, rgba(123, 212, 227, 0.018) 42%, transparent 72%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-left {
      flex: 1.15;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      max-width: 470px;
      z-index: 1;
    }

    .hero-identity {
      margin-bottom: 2.5rem;
    }

    .hero-action {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .hero-action .btn-gold {
      margin-top: 0.75rem;
    }

    .hero-right {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      background: transparent;
      z-index: 1;
    }

    .wordmark {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(3.2rem, 6vw, 4.7rem);
      font-weight: 300;
      letter-spacing: 0.35em;
      color: var(--accent-teal);
      margin-bottom: 1rem;
      text-transform: uppercase;
      text-align: left;
    }

    .wordmark-suffix {
      font-size: 0.4em;
      letter-spacing: 0.6em;
      vertical-align: 0.4em;
      opacity: 0.8;
      margin-left: 0.1em;
    }

    .hero-headline {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: clamp(1.65rem, 3vw, 2.35rem);
      font-weight: 400;
      line-height: 1.4;
      margin-bottom: 0.5rem;
      color: rgba(255, 255, 255, 0.9);
      text-align: left;
    }

    .hero-subheadline {
      font-size: 1.15rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.6);
      text-align: left;
      white-space: nowrap;
    }

    .hero-image-wrapper {
      position: relative;
      display: inline-block;
    }

    .hero-image-wrapper::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 70%;
      height: 70%;
      background: radial-gradient(ellipse at center, rgba(123, 212, 227, 0.16) 0%, rgba(123, 212, 227, 0.06) 34%, rgba(123, 212, 227, 0.015) 62%, transparent 82%);
      border-radius: 50%;
      z-index: -1;
      filter: blur(40px);
    }

    .hero-image {
      width: 100%;
      max-width: 520px;
      height: auto;
      display: block;
      filter: drop-shadow(0 0 20px rgba(123, 212, 227, 0.11)) drop-shadow(0 0 50px rgba(123, 212, 227, 0.04));
    }

    .hero-hook-setup {
      font-size: 1.3rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.5);
      line-height: 1.4;
    }

    .hero-hook-punch {
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--accent-teal);
      line-height: 1.4;
    }

    /* ── Buttons ── */
    .btn-gold {
      display: inline-block;
      padding: 0.875rem 2.5rem;
      font-size: 1.05rem;
      font-family: var(--font);
      font-weight: 600;
      background: linear-gradient(135deg, var(--accent-gold), #f0cf79);
      color: var(--bg);
      border: none;
      border-radius: 999px;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 18px 44px rgba(212, 165, 0, 0.2);
    }

    .btn-gold:hover {
      background: linear-gradient(135deg, #e5bc44, var(--accent-gold-hover));
      transform: translateY(-1px);
      box-shadow: 0 22px 54px rgba(212, 165, 0, 0.28);
    }

    .btn-outline {
      display: inline-block;
      padding: 0.875rem 2.5rem;
      font-size: 1.05rem;
      font-family: var(--font);
      font-weight: 500;
      background: transparent;
      color: var(--accent-teal);
      border: 1px solid var(--accent-teal);
      border-radius: 4px;
      text-decoration: none;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .btn-outline:hover {
      background: var(--accent-teal);
      color: var(--bg);
    }

    /* ── Problem ── */
    .problem {
      text-align: center;
      padding: 2.5rem 2rem 1.5rem;
      max-width: 640px;
      margin: 0 auto;
    }

    .problem h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .pain-points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .pain-points li {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    .problem-closer {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.75rem;
      color: var(--accent-teal);
      font-weight: 400;
    }

    /* ── Solution ── */
    .solution {
      text-align: center;
      padding: 1.5rem 2rem 2.5rem;
      max-width: 720px;
      margin: 0 auto;
    }

    .solution h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 1.5rem;
    }

    .solution p {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.15rem;
      line-height: 1.75;
      color: rgba(255, 255, 255, 0.8);
    }

    /* ── Timeline ── */
    .timeline-section {
      padding: 2.5rem 2rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .timeline {
      position: relative;
      padding-left: 3rem;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 7px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--accent-teal);
      opacity: 0.4;
    }

    .timeline-step {
      position: relative;
      margin-bottom: 2.5rem;
      padding-left: 1.5rem;
    }

    .timeline-step:last-child {
      margin-bottom: 0;
    }

    .timeline-step::before {
      content: '';
      position: absolute;
      left: -2.85rem;
      top: 0.5rem;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent-teal);
      border: 2px solid var(--bg);
      z-index: 1;
    }

    .timeline-time {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--accent-gold);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.25rem;
    }

    .timeline-label {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.5rem;
      font-weight: 400;
      color: var(--text);
      margin-bottom: 0.35rem;
    }

    .timeline-desc {
      font-size: 1rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ── Features ── */
    .features-section {
      padding: 2.5rem 2rem;
      max-width: 980px;
      margin: 0 auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }

    .feature-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 2.5rem 2rem;
      transition: border-color 0.2s ease, background 0.2s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 180px;
    }

    .feature-card:hover {
      border-color: var(--card-border-hover);
      background: rgba(255, 255, 255, 0.05);
    }

    .feature-title {
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--accent-teal);
      margin-bottom: 0.75rem;
    }

    .feature-description {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.75);
    }

    /* ── Pricing (removed — waitlist only) ── */

    /* ── Final CTA ── */
    .final-cta {
      text-align: center;
      padding: 3.5rem 2rem 4.5rem;
      max-width: 760px;
      margin: 0 auto 2rem;
      position: relative;
      isolation: isolate;
      scroll-margin-top: 5.5rem;
      overflow: visible;
    }

    .final-cta::before {
      content: '';
      position: absolute;
      inset: 1rem;
      border: 1px solid rgba(212, 165, 0, 0.12);
      border-radius: 28px;
      background:
        radial-gradient(circle at 50% -8%, rgba(212, 165, 0, 0.07) 0%, rgba(212, 165, 0, 0.03) 44%, rgba(212, 165, 0, 0) 100%),
        rgba(255, 255, 255, 0.012);
      pointer-events: none;
      z-index: -1;
    }

    .final-cta::after {
      content: '';
      position: absolute;
      inset: -2.5rem -1.5rem;
      background: radial-gradient(ellipse at 50% 50%, rgba(212, 165, 0, 0.052) 0%, rgba(212, 165, 0, 0.022) 46%, rgba(212, 165, 0, 0) 82%);
      filter: blur(34px);
      pointer-events: none;
      z-index: -2;
    }

    .final-cta h2 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 2.25rem;
      font-weight: 400;
      margin-bottom: 1rem;
    }

    .final-cta .final-subtext {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .form-row {
      display: flex;
      gap: 0.75rem;
      max-width: 460px;
      margin: 0 auto;
    }

    .hp-field {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .email-input {
      flex: 1;
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      font-family: var(--font);
      background: rgba(255, 255, 255, 0.045);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      color: var(--text);
      outline: none;
      transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .email-input::placeholder {
      color: var(--text-muted);
    }

    .email-input:focus {
      border-color: var(--accent-teal);
      box-shadow: 0 0 0 3px rgba(94, 184, 199, 0.15);
    }

    .submit-btn {
      padding: 0.75rem 1.25rem;
      font-size: 0.9rem;
      font-family: var(--font);
      font-weight: 500;
      background: linear-gradient(135deg, var(--accent-gold), #f0cf79);
      border: 1px solid rgba(212, 165, 0, 0.45);
      border-radius: 999px;
      color: var(--bg);
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
      white-space: nowrap;
    }

    .submit-btn:hover:not(:disabled) {
      border-color: rgba(240, 207, 121, 0.65);
      background: linear-gradient(135deg, #e5bc44, var(--accent-gold-hover));
      color: var(--bg);
    }

    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .form-message {
      font-size: 0.875rem;
      margin-top: 0.5rem;
    }

    .form-message.error {
      color: var(--error);
    }

    .success-message {
      color: var(--accent-gold);
      font-size: 1rem;
      font-weight: 500;
    }

    .hidden {
      display: none;
    }

    /* ── Footer ── */
    footer {
      padding: 2.5rem 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      border-top: 1px solid var(--card-border);
      max-width: 1100px;
      margin: 0 auto;
    }

    .footer-left a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-left a:hover {
      color: var(--accent-teal);
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: var(--accent-teal);
    }


    /* ── Responsive ── */
    @media (max-width: 900px) {
      .features-grid {
        grid-template-columns: repeat(2, 1fr);
      }

    }

    @media (max-width: 768px) {
      nav {
        padding: 0.75rem 1rem;
        min-height: 64px;
      }

      .nav-links {
        gap: 0.75rem;
      }

      .nav-link {
        display: none;
      }

      .nav-btn {
        font-size: 0.82rem;
        padding: 0.52rem 0.9rem;
      }

      .logo-img {
        height: 38px;
      }

      .hero {
        flex-direction: column;
        gap: 0.85rem;
        padding: 4.85rem 1rem 1.25rem;
        text-align: center;
        min-height: auto;
      }

      .hero::after {
        width: 120%;
        height: 48%;
        top: 28%;
        right: -35%;
        opacity: 0.8;
      }

      .hero-left {
        display: contents;
      }

      .hero-right {
        order: 2;
        width: 100%;
      }

      .hero-identity {
        text-align: center;
        margin-bottom: 0.95rem;
        order: 1;
        width: 100%;
      }

      .hero-action {
        align-items: center;
        text-align: center;
        gap: 0.28rem;
        width: 100%;
        order: 3;
      }

      .wordmark {
        font-size: clamp(2.2rem, 13vw, 3rem);
        letter-spacing: 0.16em;
        text-align: center;
        margin-bottom: 0.8rem;
        transform: translateX(0.08em);
      }

      .wordmark-suffix {
        display: block;
        font-size: 0.34em;
        letter-spacing: 0.48em;
        margin: 0.15rem 0 0;
        transform: translateX(0.24em);
      }

      .hero-headline {
        font-size: clamp(1.28rem, 5.8vw, 1.62rem);
        line-height: 1.18;
        max-width: 21rem;
        margin: 0 auto 0.5rem;
        text-align: center;
      }

      .hero-subheadline {
        white-space: normal;
        font-size: 0.96rem;
        max-width: 19rem;
        margin: 0 auto;
      }

      .hero-hook-setup,
      .hero-hook-punch {
        font-size: 1rem;
        max-width: 20rem;
      }

      .hero-image {
        max-width: min(60vw, 205px);
        margin: 0 auto;
      }

      .hero-image-wrapper::before {
        width: 78%;
        height: 78%;
        filter: blur(28px);
      }

      .btn-gold, .btn-outline {
        width: min(100%, 21rem);
        text-align: center;
        padding: 0.95rem 1.4rem;
      }

      .section-heading,
      .problem h2,
      .solution h2,
      .final-cta h2 {
        font-size: clamp(1.85rem, 9vw, 2.25rem);
        line-height: 1.08;
      }

      .section-subtitle,
      .final-cta .final-subtext {
        font-size: 0.98rem;
        margin-bottom: 1.75rem;
      }

      .problem, .solution, .timeline-section, .features-section, .final-cta {
        padding: 2.35rem 1rem;
      }

      .features-grid {
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }

      .feature-card,
      .compact-point {
        min-height: auto;
        padding: 1.3rem 1.15rem;
        border-radius: 14px;
      }

      .feature-title {
        font-size: 1.25rem;
      }

      .timeline::before {
        display: none;
      }

      .timeline {
        padding-left: 0;
      }

      .timeline-step {
        padding-left: 0;
        padding: 1.15rem;
        margin-bottom: 0.85rem;
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 14px;
      }

      .timeline-step::before {
        display: none;
      }

      .final-cta {
        margin-bottom: 1rem;
        overflow: hidden;
      }

      .final-cta::after {
        inset: -1.25rem 0;
      }

      .final-cta::before {
        inset: 0.6rem;
        border-radius: 22px;
      }

      .form-row {
        flex-direction: column;
        max-width: 100%;
      }

      .email-input,
      .submit-btn {
        width: 100%;
        min-height: 48px;
        text-align: center;
      }

      footer {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
        padding: 2rem 1rem;
      }
    }

